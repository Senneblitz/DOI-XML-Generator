#!/bin/sh
# Guard against publishing personal data.
#
# Only the history-free branch "public" may leave this repository. Every other branch carries the
# original reference records in its history, and those hold the names and ORCID iDs of real people.
# Tags may travel too, but only when they point at a commit of that branch - a tag on another
# branch would drag its whole history along.
#
# Installed into .git/hooks/pre-push by: node tools/public-branch.js install
# (hooks are not part of a clone, so this has to be run once per working copy).

ALLOWED_REF="refs/heads/public"
FORBIDDEN_PATHS="fixtures-private data/Creators.json data/people.json"
# Invented iDs live in the 0000-0000 block, 0000-0002-1825-009x is ORCID's fictional demo person.
ALLOWED_IDS="0000-0000-|1825-009"
ID_PATTERN="[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]"
EMPTY="0000000000000000000000000000000000000000"

remote_url="$2"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$EMPTY" ] && continue # deleting a remote branch is fine

  case "$local_ref" in
    "$ALLOWED_REF")
      target="$local_sha"
      # Which commits would actually travel: everything on the first push, the new ones afterwards.
      if [ "$remote_sha" = "$EMPTY" ]; then
        commits=$(git rev-list "$target")
      else
        commits=$(git rev-list "$target" --not "$remote_sha")
      fi
      ;;
    refs/tags/*)
      # An annotated tag pushes the tag object, so resolve it to the commit it marks.
      target=$(git rev-parse "$local_sha^{commit}" 2>/dev/null)
      if [ -z "$target" ] || ! git merge-base --is-ancestor "$target" "$ALLOWED_REF" 2>/dev/null; then
        echo "pre-push: $local_ref zeigt nicht auf einen Commit von $ALLOWED_REF." >&2
        echo "  Ein Tag auf einem anderen Zweig wuerde dessen Historie mitveroeffentlichen." >&2
        status=1
        continue
      fi
      commits="$target"
      ;;
    *)
      echo "pre-push: $local_ref darf nicht nach $remote_url gepusht werden." >&2
      echo "  Freigegeben sind $ALLOWED_REF und Tags darauf. Andere Zweige enthalten personenbezogene Daten in der Historie." >&2
      echo "  Zum Veroeffentlichen: node tools/public-branch.js sync, dann git push origin public:main" >&2
      status=1
      continue
      ;;
  esac

  if [ -n "$(git rev-list "$target" -- $FORBIDDEN_PATHS)" ]; then
    echo "pre-push: $local_ref beruehrt in seiner Historie: $FORBIDDEN_PATHS" >&2
    status=1
  fi

  for commit in $commits; do
    # Checked per iD, not per line: a line may well hold an allowed iD next to a forbidden one.
    found=$(git grep -I -n -E "$ID_PATTERN" "$commit" -- . 2>/dev/null | while IFS= read -r line; do
      if echo "$line" | grep -oE "$ID_PATTERN" | grep -qvE "$ALLOWED_IDS"; then
        echo "$line"
      fi
    done | head -5)
    if [ -n "$found" ]; then
      echo "pre-push: $commit enthaelt ORCID iDs ausserhalb des erfundenen Blocks:" >&2
      echo "$found" >&2
      status=1
    fi
  done
done

[ "$status" -ne 0 ] && echo "pre-push: Push abgebrochen." >&2
exit $status
